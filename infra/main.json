{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "6799125459730370055"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "The Azure Developer CLI environment name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The Azure region where resources are deployed."
      }
    },
    "webAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "The globally unique App Service web app name."
      }
    },
    "resourcePrefix": {
      "type": "string",
      "defaultValue": "calc",
      "metadata": {
        "description": "Short prefix used in the App Service plan name."
      }
    },
    "serviceName": {
      "type": "string",
      "defaultValue": "web",
      "metadata": {
        "description": "The azd service name. This must match the service key in azure.yaml."
      }
    },
    "runtimeStack": {
      "type": "string",
      "defaultValue": "DOTNETCORE|10.0",
      "allowedValues": [
        "DOTNETCORE|10.0"
      ],
      "metadata": {
        "description": "The Linux App Service runtime stack, aligned with the active solution."
      }
    },
    "appServicePlanSkuName": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "S1",
        "P0v3"
      ],
      "metadata": {
        "description": "The App Service plan SKU. B1 is the default single-instance development tier."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional tags applied to all deployed resources."
      }
    }
  },
  "variables": {
    "normalizedEnvironmentName": "[toLower(replace(parameters('environmentName'), '_', '-'))]",
    "resourceToken": "[uniqueString(subscription().id, resourceGroup().id, parameters('location'), parameters('environmentName'))]",
    "commonTags": "[union(parameters('tags'), createObject('azd-env-name', parameters('environmentName'), 'environment', parameters('environmentName'), 'workload', 'calculator'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-{1}-{2}-plan', parameters('resourcePrefix'), variables('normalizedEnvironmentName'), variables('resourceToken'))]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "tags": "[variables('commonTags')]",
      "sku": {
        "name": "[parameters('appServicePlanSkuName')]",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "tags": "[union(variables('commonTags'), createObject('azd-service-name', parameters('serviceName')))]",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-{1}-{2}-plan', parameters('resourcePrefix'), variables('normalizedEnvironmentName'), variables('resourceToken')))]",
        "httpsOnly": true,
        "clientAffinityEnabled": true,
        "publicNetworkAccess": "Enabled",
        "siteConfig": {
          "alwaysOn": true,
          "webSocketsEnabled": true,
          "ftpsState": "Disabled",
          "healthCheckPath": "/health",
          "http20Enabled": true,
          "linuxFxVersion": "[parameters('runtimeStack')]",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "false"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-{1}-{2}-plan', parameters('resourcePrefix'), variables('normalizedEnvironmentName'), variables('resourceToken')))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('webAppName'), 'scm')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('webAppName'), 'ftp')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('webAppName'), 'logs')]",
      "properties": {
        "applicationLogs": {
          "fileSystem": {
            "level": "Information"
          }
        },
        "httpLogs": {
          "fileSystem": {
            "enabled": true,
            "retentionInDays": 3,
            "retentionInMb": 35
          }
        },
        "detailedErrorMessages": {
          "enabled": false
        },
        "failedRequestsTracing": {
          "enabled": false
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ]
    }
  ],
  "outputs": {
    "AZURE_LOCATION": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "RESOURCE_GROUP_ID": {
      "type": "string",
      "value": "[resourceGroup().id]"
    },
    "SERVICE_WEB_NAME": {
      "type": "string",
      "value": "[parameters('webAppName')]"
    },
    "SERVICE_WEB_URI": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01').defaultHostName)]"
    }
  }
}