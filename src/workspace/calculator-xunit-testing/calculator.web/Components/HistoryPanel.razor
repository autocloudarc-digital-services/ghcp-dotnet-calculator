<section class="history-panel card" aria-labelledby="history-heading">
    <div class="panel-heading">
        <h2 id="history-heading">History</h2>
        <button type="button" class="text-button" disabled="@(Entries.Count == 0)"
                @onclick="ClearRequested">Clear</button>
    </div>
    <p class="hint">This session only. Select a result to use it again.</p>
    @if (Entries.Count == 0)
    {
        <p class="empty-history">Your calculations will appear here.</p>
    }
    else
    {
        <ol class="history-list">
            @foreach (var record in Entries)
            {
                <li>
                    <button type="button" class="history-entry"
                            aria-label="@($"Replay {record.Expression} equals {record.ResultText}")"
                            @onclick="() => ReplayRequested.InvokeAsync(record)">
                        <span>@record.Expression =</span>
                        <strong>@record.ResultText</strong>
                    </button>
                </li>
            }
        </ol>
    }
</section>

@code {
    /// <summary>Gets or sets the current circuit's calculation history.</summary>
    [Parameter]
    public IReadOnlyList<CalculationRecord> Entries { get; set; } = Array.Empty<CalculationRecord>();

    /// <summary>Gets or sets the handler for clearing history.</summary>
    [Parameter]
    public EventCallback ClearRequested { get; set; }

    /// <summary>Gets or sets the handler for replaying a completed calculation.</summary>
    [Parameter]
    public EventCallback<CalculationRecord> ReplayRequested { get; set; }
}
