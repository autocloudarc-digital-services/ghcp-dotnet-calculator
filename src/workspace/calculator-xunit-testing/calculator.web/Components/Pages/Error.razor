@page "/Error"
@using System.Diagnostics

<PageTitle>Calculator error</PageTitle>
<main class="error-page">
<h1>The calculator could not complete your request</h1>
<p>Please reload the calculator. If the problem continues, share the request ID with support.</p>
<a href="/">Return to calculator</a>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

</main>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
