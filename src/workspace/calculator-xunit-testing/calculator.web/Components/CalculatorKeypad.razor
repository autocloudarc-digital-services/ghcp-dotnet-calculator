<div class="keypad" aria-label="Calculator keypad">
    @foreach (var key in Keys)
    {
        <button type="button" class="key @key.Style" aria-label="@key.Name"
                @onclick="() => KeyPressed.InvokeAsync(key.Value)">@key.Text</button>
    }
</div>

@code {
    /// <summary>Gets or sets the handler for keypad actions.</summary>
    [Parameter]
    public EventCallback<string> KeyPressed { get; set; }

    private static readonly (string Text, string Name, string Value, string Style)[] Keys =
    [
        ("C", "Clear", "C", "key-clear"), ("^", "Power", "^", "key-operator"),
        ("%", "Modulo", "%", "key-operator"), ("\u00f7", "Divide", "/", "key-operator"),
        ("7", "Seven", "7", ""), ("8", "Eight", "8", ""),
        ("9", "Nine", "9", ""), ("\u00d7", "Multiply", "*", "key-operator"),
        ("4", "Four", "4", ""), ("5", "Five", "5", ""),
        ("6", "Six", "6", ""), ("\u2212", "Subtract", "-", "key-operator"),
        ("1", "One", "1", ""), ("2", "Two", "2", ""),
        ("3", "Three", "3", ""), ("+", "Add", "+", "key-operator"),
        ("0", "Zero", "0", "key-zero"), (".", "Decimal point", ".", ""),
        ("=", "Equals", "=", "key-equals")
    ];
}
